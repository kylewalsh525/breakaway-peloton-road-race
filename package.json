{
  "name": "breakaway-peloton-racer",
  "version": "0.9.0",
  "private": true,
  "type": "module",
  "description": "Voice-first, pedal-powered arcade racing. Original artwork, authoritative multiplayer, and an isolated Android bike adapter.",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "start": "node server/main.mjs",
    "dev": "node --watch server/main.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:coverage": "node --test --experimental-test-coverage tests/*.test.mjs",
    "test:e2e": "python3 scripts/browser_test.py",
    "test:load": "node scripts/load-test.mjs",
    "check": "node scripts/check.mjs",
    "build": "node scripts/build.mjs",
    "verify": "npm run check && npm test && npm run build",
    "test:ui": "node scripts/retro-browser-test.mjs",
    "test:multiplayer-ui": "node scripts/multiplayer_browser_test.mjs",
    "test:combat-render": "node scripts/combat-render-test.mjs",
    "test:combat-voice": "node scripts/combat-voice-browser-test.mjs",
    "test:combat-network": "node scripts/combat-network-test.mjs"
  }
}
