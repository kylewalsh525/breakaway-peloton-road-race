# npm start automatically reads .env on Node 22+. Omit .env for localhost defaults.
HOST=127.0.0.1
PORT=8787
# Set this only for deployed HTTPS hosting. Leave unset for localhost development.
# PUBLIC_ORIGIN=https://race.example.com
# Comma-separated exact origins, never '*'. The bundled Android origin is already allowed.
ALLOWED_ORIGINS=https://app.breakaway.local
# Optional: a strong invitation passphrase for a friends/family server.
ACCESS_CODE=
MAX_ROOMS=32
MAX_SESSIONS=256
DATA_DIR=./server/data
# Docker/Caddy only: set a real domain whose DNS points at your server.
# RACE_DOMAIN=race.example.com
